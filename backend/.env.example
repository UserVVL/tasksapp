# Скопируйте этот файл в backend/.env и заполните значения.
# backend/.env в .gitignore — секреты не попадут в репозиторий.

# Строка подключения к БД (по умолчанию — локальная SQLite для разработки)
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Продакшен (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://texturetasks:<ПАРОЛЬ>@localhost:5432/texturetasks

# Секрет для подписи JWT. В проде ОБЯЗАТЕЛЬНО длинное случайное значение,
# иначе все сессии инвалидируются при рестарте (см. критический лог старта).
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Пароль PostgreSQL для pg_dump (регулярные бэкапы БД в backend/backups/).
# Пусто = бэкапы БД будут падать с ошибкой аутентификации.
PGPASSWORD=

# Необязательные параметры подключения pg_dump
# (используются, только если заданы в окружении процесса; дефолты ниже)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=texturetasks
# PG_USER=texturetasks

# Необязательные настройки приложения (значения по умолчанию см. app/config.py)
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# MAX_FILE_SIZE_MB=10
