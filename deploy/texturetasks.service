[Unit]
Description=TextureTasks API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/texturetasks/backend
ExecStart=/opt/texturetasks/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
EnvironmentFile=/opt/texturetasks/backend/.env

[Install]
WantedBy=multi-user.target
